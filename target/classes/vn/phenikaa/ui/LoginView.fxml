<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane style="-fx-background-color: #f1f5f9;" stylesheets="@main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.phenikaa.controller.LoginController">

    <VBox alignment="CENTER" maxWidth="450" styleClass="login-card">
        
        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: #1e293b;" text="PHENIKAA HRM"/>
            <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Hệ thống Quản lý Nhân sự"/>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label style="-fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Tên đăng nhập"/>
                <TextField fx:id="txtUsername" promptText="Nhập tài khoản" styleClass="search-field"/>
            </VBox>

            <VBox spacing="5">
                <Label style="-fx-text-fill: #1e293b; -fx-font-weight: bold;" text="Mật khẩu"/>
                <PasswordField fx:id="txtPassword" onAction="#handleLogin" promptText="••••••••" styleClass="search-field"/>
            </VBox>
        </VBox>

        <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="45" styleClass="btn-primary" text="Đăng nhập hệ thống" />

        <Label fx:id="lblMessage" textFill="#ef4444" style="-fx-font-weight: bold;" />
    </VBox>

</StackPane>
